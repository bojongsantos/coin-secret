# Optional local-only demo controls. Never enable these as production auth.
# PostgreSQL (use a pooled URL on Vercel).
DATABASE_URL=postgresql://coinsecret:coinsecret_dev@localhost:5433/coinsecret

# Better Auth. Generate with: openssl rand -base64 32
# BETTER_AUTH_URL doubles as the public origin payment providers call back to.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
REQUIRE_EMAIL_VERIFICATION=false

# Extra origins allowed to drive the auth endpoints, comma separated. Needed
# when a deployment answers on more than one domain — for example the domain it
# was renamed from. This is a CSRF control: only list origins you own.
# In development the loopback aliases and this machine's own LAN addresses are
# trusted automatically, so the "Network" URL `next dev` prints just works.
# TRUSTED_ORIGINS=https://old-domain.example

# Transactional email via Brevo (verification and password reset).
# EMAIL_FROM must be an address verified in Brevo. Brevo can verify a single
# address by emailed link, so no domain of your own is required to start.
# Without these two, sending logs to the console in development and raises in
# production rather than failing silently.
BREVO_API_KEY=xkeysib-your-api-key
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=Coin Secret

# Which provider takes payments. Unknown values refuse to charge.
PAYMENT_PROVIDER=midtrans
PREMIUM_PRICE_IDR=99000

# Midtrans Snap. Keep server key private; expose only the client key.
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=SB-Mid-server-your-server-key
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-your-client-key

# NOWPayments (crypto). Set PAYMENT_PROVIDER=nowpayments to use it.
# The IPN secret is a separate value from the API key, created under
# Settings > Payments > Instant Payment Notifications. Callback URL to register
# there: https://DOMAIN/api/billing/webhook/nowpayments
NOWPAYMENTS_API_KEY=your-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=your-nowpayments-ipn-secret

# Market watch cron. Required for price alerts and setup evaluation to run.
# Generate with: openssl rand -base64 32
# Without it, /api/cron/market-watch stays closed and returns 503.
CRON_SECRET=replace-with-a-long-random-string

# Optional local/demo seed credentials. Never reuse these in production.
SEED_USER_PASSWORD=CoinSecret123!
SEED_ADMIN_PASSWORD=CoinSecret123!
