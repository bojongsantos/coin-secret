generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum Plan {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  INACTIVE
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SETTLED
  FAILED
  EXPIRED
  CANCELED
  REFUNDED
}

enum AlertCondition {
  PRICE_ABOVE
  PRICE_BELOW
}

enum AlertStatus {
  ACTIVE
  TRIGGERED
  PAUSED
}

enum SetupCaptureKind {
  ENTRY
  RESULT
}

enum NotificationKind {
  ALERT_TRIGGERED
  SETUP_RESOLVED
  BILLING
  SYSTEM
}

enum SetupOutcome {
  OPEN
  TARGET_HIT
  STOPPED_OUT
  CANCELED
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          UserRole @default(USER)
  plan          Plan     @default(FREE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions       Session[]
  accounts       Account[]
  watchlist      WatchlistItem[]
  subscription   Subscription?
  payments       Payment[]
  featureGrants  UserFeatureGrant[]
  auditEvents    AuditLog[] @relation("AuditActor")
  priceAlerts    PriceAlert[]
  notifications  Notification[]
  journalEntries SetupJournalEntry[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

model WatchlistItem {
  id        String   @id @default(cuid())
  symbol    String
  enabled   Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Snapshot of the setup saved alongside the symbol. All null until the user
  /// saves one, so a plain watchlist entry stays exactly as it was.
  setupTimeframe  String?
  setupDirection  String?
  setupEntry      Float?
  setupTarget1    Float?
  setupTarget2    Float?
  setupStopLoss   Float?
  setupRiskReward Float?
  setupConfidence Int?
  setupSavedAt    DateTime?

  @@unique([userId, symbol])
  @@index([userId, enabled, position])
}

model Subscription {
  id                     String             @id @default(cuid())
  status                 SubscriptionStatus @default(INACTIVE)
  plan                   Plan               @default(FREE)
  provider               String?
  providerSubscriptionId String?            @unique
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  userId                 String             @unique
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id                    String        @id @default(cuid())
  orderId               String        @unique
  providerTransactionId String?       @unique
  provider              String
  amount                Int
  currency              String        @default("IDR")
  status                PaymentStatus @default(PENDING)
  checkoutToken         String?
  checkoutUrl           String?
  rawStatus             String?
  paidAt                DateTime?
  expiresAt             DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  userId                String
  user                  User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model FeatureGate {
  id        String   @id @default(cuid())
  feature   String   @unique
  free      Boolean  @default(false)
  premium   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model UserFeatureGrant {
  id        String   @id @default(cuid())
  feature   String
  enabled   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature])
  @@index([userId])
}

model PriceAlert {
  id             String         @id @default(cuid())
  symbol         String
  condition      AlertCondition
  threshold      Float
  status         AlertStatus    @default(ACTIVE)
  note           String?
  triggeredAt    DateTime?
  triggeredPrice Float?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  // Drives the cron sweep, which reads every active alert across all users.
  @@index([status, symbol])
}

model Notification {
  id        String           @id @default(cuid())
  kind      NotificationKind @default(SYSTEM)
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model SetupJournalEntry {
  id          String       @id @default(cuid())
  symbol      String
  timeframe   String
  direction   String
  entry       Float
  target1     Float
  target2     Float
  stopLoss    Float
  riskReward  Float
  confidence  Int
  outcome     SetupOutcome @default(OPEN)
  closedPrice Float?
  closedAt    DateTime?
  /** Identity of the setup itself, so saving it twice does not duplicate it. */
  signature   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, signature])
  @@index([userId, createdAt])
  @@index([outcome, symbol])
}

/// A setup the scanner is following so status changes can be noticed.
///
/// Status is derived fresh on every scan, so a transition is only visible by
/// remembering what it was last time. Without this row the sweep would see
/// "Filled" and have no way to tell a fill that just happened from one it has
/// already photographed a hundred times.
model TrackedSetup {
  id         String   @id @default(cuid())
  symbol     String
  timeframe  String
  direction  String
  entry      Float
  target1    Float
  target2    Float
  stopLoss   Float
  riskReward Float
  confidence Int
  zoneTop    Float
  zoneBottom Float
  status     String
  /// Identity of the setup itself, so the same zone is one row across sweeps.
  signature  String   @unique
  /// Set once both snapshots exist and the proof image can be rendered.
  resultAt   DateTime?
  firstSeenAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  snapshots SetupSnapshot[]

  @@index([symbol, updatedAt])
  @@index([resultAt])
}

/// One photograph of a setup at a moment worth keeping.
///
/// Stores the numbers the picture is drawn from rather than the drawing. The
/// composed image repeats both snapshots inside it, so keeping rendered SVG
/// would store the same candles three times over — and a change to the layout
/// would leave every archived image stuck in the old design.
model SetupSnapshot {
  id        String           @id @default(cuid())
  kind      SetupCaptureKind
  status    String
  price     Float
  payload   Json
  capturedAt DateTime        @default(now())
  setupId   String
  setup     TrackedSetup     @relation(fields: [setupId], references: [id], onDelete: Cascade)

  @@unique([setupId, kind])
  @@index([capturedAt])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}
